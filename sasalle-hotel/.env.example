# SASALLE HOTEL — Environment template
# Copy to .env.local for local development

# Site URL (required for admin booking fetch in production)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# WhatsApp Business (E.164 without +, e.g. 6281234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/6281234567890

# Social (luxury minimal — icon-only footer)
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/sasallehotel
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@sasallehotel
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/sasallehotel

# OTA partner deep links (property-specific URLs in production)
NEXT_PUBLIC_OTA_BOOKING_URL=https://www.booking.com
NEXT_PUBLIC_OTA_AGODA_URL=https://www.agoda.com
NEXT_PUBLIC_OTA_TRAVELOKA_URL=https://www.traveloka.com
NEXT_PUBLIC_OTA_TIKET_URL=https://www.tiket.com
NEXT_PUBLIC_OTA_TRIP_URL=https://www.trip.com
